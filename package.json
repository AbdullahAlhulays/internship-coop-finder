{
  "name": "internship-coop-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate-sitemap.mjs",
    "dev": "vite",
    "build": "vite build --configLoader runner",
    "postbuild": "node scripts/generate-company-pages.mjs",
    "check:seo": "node scripts/verify-seo.mjs",
    "preview": "vite preview --configLoader runner",
    "test:cv:model": "node --test scripts/test-cv-model.mjs",
    "test:cv:browser": "node scripts/test-cv-browser.mjs",
    "test:cv": "npm run test:cv:model && npm run test:cv:browser && npm run test:cv:recovery",
    "test:cv:recovery": "node scripts/test-cv-recovery.mjs",
    "test:navigation": "node scripts/test-navigation.mjs",
    "perf:measure": "node scripts/measure-performance.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "pdfjs-dist": "^6.5.438"
  }
}
