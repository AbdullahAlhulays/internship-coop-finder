{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/build-cv/:path*", "destination": "/" },
    { "source": "/ar/build-cv/:path*", "destination": "/ar" }
  ],
  "headers": [
    {
      "source": "/build-cv/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/ar/build-cv/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
